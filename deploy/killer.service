[Unit]
# Шаблон systemd-юнита для «Киллер / Папарацци» (веб + Telegram/VK боты).
# Замените плейсхолдеры __USER__ и __APP_DIR__ (это делает deploy/setup-service.sh)
# и положите файл в /etc/systemd/system/killer.service.
Description=Killer/Paparazzi — web + Telegram/VK боты
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__APP_DIR__
ExecStart=__APP_DIR__/.venv/bin/python run_all.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
